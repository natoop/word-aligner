ALIGNER_MODEL=xlmr
ALIGNER_TOKEN_TYPE=word
ALIGNER_LAYER=8
ALIGNER_MATCHING_METHODS=mai
ALIGNER_CONFIDENCE_TEMPERATURE=0.1
ALIGNER_DEVICE=cpu
ALIGNER_EAGER_LOAD=false

# Keep Hugging Face model files outside the application directory in production.
HF_HOME=/models
HF_MODEL_UPDATE_POLICY=if-missing

# Optional OpenAI-compatible LLM providers for independent alignment validation.
# Optional provider order. When empty or omitted, providers are discovered from
# LLM_<ID>_NAME, LLM_<ID>_BASE_URL, and LLM_<ID>_MODEL. With no provider settings,
# the LLM endpoints remain disabled.
# Provider BASE_URL values include the API prefix such as /v1, but not /chat/completions.
LLM_PROVIDERS=
# LLM_DEFAULT_PROVIDER=deepseek
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=8192

# DeepSeek example
# LLM_DEEPSEEK_NAME=DeepSeek
# LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# LLM_DEEPSEEK_MODEL=deepseek-chat
# LLM_DEEPSEEK_API_KEY=
# LLM_DEEPSEEK_RESPONSE_FORMAT=json_object

# OpenAI example
# LLM_OPENAI_NAME=OpenAI
# LLM_OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_OPENAI_MODEL=gpt-4.1-mini
# LLM_OPENAI_API_KEY=
# LLM_OPENAI_RESPONSE_FORMAT=json_schema
# OpenAI recommends max_completion_tokens; DeepSeek and many compatible providers use max_tokens.
# LLM_OPENAI_MAX_TOKENS_PARAMETER=max_completion_tokens

# Local OpenAI-compatible server example (API key may be empty)
# LLM_LOCAL_NAME=Local server
# LLM_LOCAL_BASE_URL=http://localhost:11434/v1
# LLM_LOCAL_MODEL=your-local-model
# LLM_LOCAL_API_KEY=
# LLM_LOCAL_RESPONSE_FORMAT=json_object
